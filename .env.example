# ============================================================
# CE Translator – Umgebungsvariablen / Environment Variables
# ============================================================
# Für lokale Entwicklung: Kopiere diese Datei als ".env" nach apps/api/
# Für Heroku: Setze als Config Vars (heroku config:set NAME=Wert)
# Für Vercel: Setze unter Settings → Environment Variables im Dashboard
# ============================================================

# --- Server ---
PORT=3001
NODE_ENV=production

# CORS: Deine App-URL, z.B.:
#   Heroku: https://meine-app.herokuapp.com
#   Vercel:  https://meine-app.vercel.app
#   Eigene Domain: https://meineapp.de
CORS_ORIGIN=https://DEINE-APP.vercel.app

# --- OpenAI / KI-Übersetzung ---
# Dein OpenAI API-Key (https://platform.openai.com/api-keys)
INTEGRATED_AI_API_KEY=sk-...

# OpenAI API Basis-URL (normalerweise nicht ändern)
INTEGRATED_AI_API_URL=https://api.openai.com/v1

# OpenAI TTS-Modell für Sprachausgabe (tts-1 oder tts-1-hd)
OPENAI_TTS_MODEL=tts-1

# --- Datenbank (optional) ---
# PocketBase-Server URL (nur wenn du PocketBase extern betreibst)
# Auf Vercel: PocketBase muss extern gehostet werden (z.B. Railway, VPS)
# Auf Heroku: Kein persistentes Dateisystem – ebenfalls extern hosten
# Auf Hostinger Horizons: Automatisch konfiguriert (nicht nötig)
# POCKETBASE_URL=https://pb.meinserver.de

# --- Hostinger-spezifische Variablen (nur auf Hostinger Horizons) ---
# Diese Variablen werden auf Heroku/Vercel NICHT benötigt
# WEBSITE_ID=
# WEBSITE_DOMAIN=
# PROXY_ENTRANCE_ID=
# PB_SUPERUSER_EMAIL=
# PB_SUPERUSER_PASSWORD=
