{
  "name": "monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "setup": "npm install",
    "dev": "concurrently --kill-others --raw \"npm run dev --prefix apps/web\" \"npm run dev --prefix apps/api\" \"npm run dev --prefix apps/pocketbase\"",
    "build": "vite build",
    "heroku-postbuild": "npm run build --workspace apps/web",
    "start": "serve -s dist -l tcp://0.0.0.0:${PORT:-3000}",
    "lint": "concurrently --raw \"npm run lint --prefix apps/web\" \"npm run lint --prefix apps/api\""
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  },
  "workspaces": [
    "apps/*"
  ],
  "dependencies": {
    "serve": "^14.2.6"
  }
}
