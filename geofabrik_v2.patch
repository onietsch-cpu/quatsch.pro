+    # Interleave countries within the large market groups. This prevents the
+    # first dense country (previously the UK and Germany) from filling an entire
+    # quota before the USA, Canada, Australia, Austria and Switzerland are read.
+    def interleave_by_country(specs: list[ExtractSpec], country_order: list[str]) -> list[ExtractSpec]:
+        buckets: dict[str, list[ExtractSpec]] = defaultdict(list)
+        for item in specs:
+            buckets[item.country_code].append(item)
+        result: list[ExtractSpec] = []
+        while any(buckets.values()):
+            progress = False
+            for country in country_order:
+                if buckets.get(country):
+                    result.append(buckets[country].pop(0))
+                    progress = True
+            for country in sorted(buckets):
+                if country not in country_order and buckets[country]:
+                    result.append(buckets[country].pop(0))
+                    progress = True
+            if not progress:
+                break
+        return result
+
